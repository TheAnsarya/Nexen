<Window
	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:vm="using:Mesen.ViewModels"
	xmlns:l="using:Mesen.Localization"
	xmlns:c="using:Mesen.Controls"
	mc:Ignorable="d"
	x:DataType="vm:BindingListViewModel"
	x:Class="Mesen.Windows.ButtonBindingsWindow"
	SizeToContent="WidthAndHeight"
	CanResize="False"
	WindowStartupLocation="CenterOwner"
>
	<StackPanel Margin="10" MinWidth="340">
		<TextBlock Text="{l:Translate lblHint}" TextWrapping="Wrap" MaxWidth="340" Margin="0 0 0 8" />

		<ItemsControl ItemsSource="{Binding Slots}">
			<ItemsControl.ItemTemplate>
				<DataTemplate x:DataType="vm:BindingSlotViewModel">
					<Grid ColumnDefinitions="*,Auto" Margin="0 2" IsVisible="{Binding IsVisible}">
						<c:KeyBindingButton Height="30" KeyBinding="{Binding Key, Mode=TwoWay}" EnableMultiBinding="False" EmptyText="{l:Translate lblAddBinding}" />
						<Button Grid.Column="1" Content="X" Width="30" Height="30" Margin="4 0 0 0" HorizontalContentAlignment="Center" Command="{Binding ClearCommand}" IsVisible="{Binding IsBound}" />
					</Grid>
				</DataTemplate>
			</ItemsControl.ItemTemplate>
		</ItemsControl>

		<Button Margin="0 10 0 0" HorizontalAlignment="Right" MinWidth="70" HorizontalContentAlignment="Center" Click="btnClose_OnClick" Content="{l:Translate btnClose}" />
	</StackPanel>
</Window>
