<Window
	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	mc:Ignorable="d"
	x:Class="Nexen.Windows.SplashWindow"
	Width="500" Height="390"
	CanResize="False"
	WindowDecorations="None"
	WindowStartupLocation="CenterScreen"
	Background="{DynamicResource NexenStartupWindowBackgroundBrush}"
	TransparencyLevelHint="Transparent"
	Topmost="True"
>
	<Border
		CornerRadius="12"
		Background="{DynamicResource NexenStartupSplashBackgroundBrush}"
		BorderBrush="{DynamicResource NexenStartupSplashBorderBrush}"
		BorderThickness="1"
		Padding="28"
	>
		<Grid RowDefinitions="*,Auto">
			<!-- Nexen Logo (cropped from big-logo.png) -->
			<Image
				Grid.Row="0"
				Source="/Assets/SplashLogo.png"
				MaxWidth="280"
				MaxHeight="280"
				HorizontalAlignment="Center"
				VerticalAlignment="Center"
				Stretch="Uniform"
			/>

			<!-- Loading indicator -->
			<StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0 12 0 4">
				<TextBlock
					Name="StatusText"
					Text="Loading..."
					FontSize="{DynamicResource NexenMenuFontSize}"
					Foreground="{DynamicResource NexenStartupSplashStatusBrush}"
					HorizontalAlignment="Center"
				/>
				<ProgressBar
					Name="LoadingBar"
					Minimum="0"
					Maximum="100"
					Value="12"
					Width="300"
					Height="14"
					Margin="0 8 0 0"
					BorderThickness="1.5"
					BorderBrush="{DynamicResource NexenStartupSplashBorderBrush}"
					Foreground="{DynamicResource NexenStartupProgressForegroundBrush}"
					Background="{DynamicResource NexenStartupProgressBackgroundBrush}"
				/>
			</StackPanel>
		</Grid>
	</Border>
</Window>
